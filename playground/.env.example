# Database connection (PostgreSQL)
# For local development with Docker:
# DATABASE_URL="postgresql://fortune:fortune_secret@localhost:5432/fortune_wheel"
#
# For remote database (e.g., Aiven):
DATABASE_URL="postgres://user:password@host:port/database?sslmode=require"

# QR Code signing secret (REQUIRED IN PRODUCTION!)
# Generate a secure random string for production
QR_SECRET="your-secure-random-secret-here-change-in-production"
