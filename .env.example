# ===========================================
# Nuxt Fortune Wheel - Configuration
# ===========================================
# Copiez ce fichier vers .env et configurez vos valeurs

# URL de base de l'API Fortune Wheel
# Exemple: https://api.votresite.com ou http://localhost:3000
FORTUNE_WHEEL_API_URL=http://localhost:3000

# Endpoints (optionnels - valeurs par défaut si non définis)
FORTUNE_WHEEL_CATALOG_ENDPOINT=/api/fortune-wheel/catalog
FORTUNE_WHEEL_CONFIG_ENDPOINT=/api/fortune-wheel/config
FORTUNE_WHEEL_PRIZE_ENDPOINT=/api/fortune-wheel/prize

# Durée d'animation par défaut (en ms)
FORTUNE_WHEEL_SPIN_DURATION=4000

# Durée de validité du QR code (en heures)
FORTUNE_WHEEL_QR_VALIDITY_HOURS=24
